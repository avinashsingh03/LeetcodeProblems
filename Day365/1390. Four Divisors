class Solution {
public:
    int sumFourDivisors(vector<int>& nums) {
        int ans=0;
        int count=0;
        for(int i=0;i<nums.size();i++){
            int temp=0;
            for(int j=1;j*j<=nums[i];j++){
                if(nums[i]%j==0 ){
                    int other=nums[i]/j;
                    if(j==other){
                        count++;
                        temp+=j;
                    }
                    else{
                        count+=2;
                        temp+=(j+other);
                    }
                }
                if(count>4){
                    break;
                }
            }
            if(count==4){
                ans+=temp;
            }
            count=0;
        }
        return ans;
    }
};
